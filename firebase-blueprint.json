{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "staff"] },
        "department": { "type": "string" },
        "year": { "type": "string" },
        "section": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Student": {
      "title": "Student",
      "description": "Student record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "rollNumber": { "type": "string" },
        "photoUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "rollNumber"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "A single attendance entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "status": { "type": "string", "enum": ["present", "absent", "late"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "confidence": { "type": "number" }
      },
      "required": ["studentId", "status", "timestamp"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Student database"
    },
    "/attendance/{recordId}": {
      "schema": "AttendanceRecord",
      "description": "Attendance history"
    }
  }
}
